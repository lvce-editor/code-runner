{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "types": ["node"]
  },
  "include": ["src"]
}
