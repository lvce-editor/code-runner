{
  "compilerOptions": {
    "lib": ["esnext", "WebWorker"],
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": true
  },
  "include": ["src", "fixtures"]
}
